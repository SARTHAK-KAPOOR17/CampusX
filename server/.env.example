PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://campusx_user:campusx_password@localhost:5432/campusx_db?schema=public"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
BODY_LIMIT="10mb"
LOG_LEVEL="info"

# Auth & JWT
JWT_ACCESS_SECRET="change-me-to-a-strong-random-64-char-secret-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

# Admin Seed
ADMIN_NAME="CampusX Admin"
ADMIN_EMAIL="admin@campusx.edu"
ADMIN_PASSWORD="Admin@CampusX2026!"

# Student Verification & SMTP
ALLOWED_COLLEGE_DOMAINS="campusx.edu,university.edu,mit.edu,stanford.edu,iitd.ac.in"
OTP_EXPIRY_MINUTES=10
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CampusX <noreply@campusx.edu>"

# Marketplace Lifecycle & Cron
LISTING_EXPIRY_DAYS=60
ENABLE_CRON=true

# Object Storage (MinIO in dev / AWS S3 or Cloudflare R2 in prod)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_PUBLIC_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="campusx-media"
STORAGE_ACCESS_KEY="change-me-minio-access-key"
STORAGE_SECRET_KEY="change-me-minio-secret-key"
STORAGE_FORCE_PATH_STYLE=true
CDN_BASE_URL=""
SIGNED_URL_EXPIRY_SECONDS=900
