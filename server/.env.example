PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://campusx_user:campusx_password@localhost:5432/campusx_db?schema=public"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
BODY_LIMIT="10mb"
LOG_LEVEL="info"

# Auth & JWT
JWT_ACCESS_SECRET="change-me-to-a-strong-random-64-char-secret-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

# Admin Seed
ADMIN_NAME="CampusX Admin"
ADMIN_EMAIL="admin@campusx.edu"
ADMIN_PASSWORD="Admin@CampusX2026!"
