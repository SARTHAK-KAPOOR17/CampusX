// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MODERATOR
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  USED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  EXPIRED
  UNDER_REVIEW
}

model User {
  id                String         @id @default(uuid())
  name              String
  email             String         @unique
  passwordHash      String?
  googleId          String?        @unique
  authProvider      AuthProvider   @default(LOCAL)
  emailVerified     Boolean        @default(false)
  role              Role           @default(STUDENT)
  isActive          Boolean        @default(true)
  collegeEmail      String?        @unique
  isVerifiedStudent Boolean        @default(false)
  verifiedAt        DateTime?
  avatarKey         String?
  course            String?
  branch            String?
  year              Int?
  bio               String?        @db.VarChar(300)
  ratingAverage     Float          @default(0)
  ratingCount       Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  refreshTokens     RefreshToken[]
  emailOtps         EmailOtp[]
  products          Product[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailOtp {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeEmail String
  otpHash      String
  expiresAt    DateTime
  attempts     Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([collegeEmail])
  @@map("email_otps")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]

  @@map("categories")
}

model Product {
  id           String         @id @default(uuid())
  sellerId     String
  seller       User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title        String         @db.VarChar(120)
  description  String?        @db.VarChar(2000)
  price        Decimal?       @db.Decimal(10, 2)
  condition    Condition?
  status       ListingStatus  @default(DRAFT)
  isNegotiable Boolean        @default(true)
  viewCount    Int            @default(0)
  tags         String[]       @default([])
  publishedAt  DateTime?
  expiresAt    DateTime?
  soldAt       DateTime?
  deletedAt    DateTime?
  searchVector Unsupported("tsvector")?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  images       ProductImage[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@index([createdAt])
  @@index([status, categoryId, price])
  @@index([status, publishedAt])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey  String
  position    Int      @default(0)
  isPrimary   Boolean  @default(false)
  width       Int
  height      Int
  sizeBytes   Int
  blurDataUrl String
  createdAt   DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}
