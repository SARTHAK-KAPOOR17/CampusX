# ==============================================
# CampusX Root Docker Compose Environment Template
# ==============================================

# PostgreSQL Configuration
POSTGRES_USER=campusx_user
POSTGRES_PASSWORD=campusx_password
POSTGRES_DB=campusx_db
POSTGRES_PORT=5432

# Server Configuration
SERVER_PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://campusx_user:campusx_password@postgres:5432/campusx_db?schema=public
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
BODY_LIMIT=10mb
LOG_LEVEL=info

# Auth & JWT
JWT_ACCESS_SECRET=change-me-to-a-strong-random-64-char-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

# Admin Seed
ADMIN_NAME=CampusX Admin
ADMIN_EMAIL=admin@campusx.edu
ADMIN_PASSWORD=Admin@CampusX2026!

# Student Verification & SMTP
ALLOWED_COLLEGE_DOMAINS=campusx.edu,university.edu,mit.edu,stanford.edu,iitd.ac.in
OTP_EXPIRY_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CampusX <noreply@campusx.edu>

# Marketplace Lifecycle & Cron
LISTING_EXPIRY_DAYS=60
ENABLE_CRON=true

# Client Configuration
CLIENT_PORT=5173
VITE_API_URL=http://localhost:5000
VITE_AI_SERVICE_URL=http://localhost:8000

# AI Service Configuration
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_ENV=development
